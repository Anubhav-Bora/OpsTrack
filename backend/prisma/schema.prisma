datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  BACKEND
  FRONTEND
  DEVOPS
  CYBERSECURITY
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  role      UserRole

  tasks     Task[]
  roomsCreated Room[] @relation("RoomCreator")
  roomMemberships RoomMember[]

  createdAt DateTime @default(now())
}

model Room {
  id        Int      @id @default(autoincrement())
  name      String

  createdBy Int
  creator   User     @relation("RoomCreator", fields: [createdBy], references: [id])

  members   RoomMember[]
  tasks     Task[]

  createdAt DateTime @default(now())
}

model Task {
  id           Int        @id @default(autoincrement())
  title        String
  status       TaskStatus @default(PENDING)

  requiredRole UserRole

  assignedTo   Int?
  assignee     User?      @relation(fields: [assignedTo], references: [id])

  roomId       Int
  room         Room       @relation(fields: [roomId], references: [id])

  dependencies TaskDependency[] @relation("TaskDependsOn")
  dependents   TaskDependency[] @relation("TaskIsPrerequisite")

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum RoomRole {
  LEADER
  ADMIN
  MEMBER
}

model RoomMember {
  id        Int      @id @default(autoincrement())
  
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id])
  
  role      RoomRole @default(MEMBER)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, roomId])
}

model TaskDependency {
  id              Int @id @default(autoincrement())

  taskId          Int
  dependsOnTaskId Int

  task        Task @relation("TaskDependsOn", fields: [taskId], references: [id])
  dependsOn   Task @relation("TaskIsPrerequisite", fields: [dependsOnTaskId], references: [id])

  @@unique([taskId, dependsOnTaskId])
}
