{
    "version": 2,
    "builds": [
        {
            "src": "api/index.ts",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "prisma/schema.prisma",
                    "prisma.config.ts",
                    "node_modules/.prisma/**",
                    "node_modules/@prisma/client/**"
                ]
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/index.ts"
        }
    ],
    "env": {
        "DATABASE_URL": "@database_url"
    }
}